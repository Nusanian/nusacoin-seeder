[Unit]
Description=Nusacoin DNS seeder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nusacoin-seeder
ExecStart=/opt/nusacoin-seeder/dnsseed \
  -a 204.13.232.148 \
  -h seednx.taobot.org \
  -n ns1.taobot.org \
  -m admin.taobot.org \
  --p2port 28573 \
  --magic 4e555341 \
  --minheight 70000 \
  -s 163.245.193.102 \
  -s 204.13.232.148 \
  -s 202.10.38.22
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
